    "description": "Displays a shipping countdown on the product detail page",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "require": {
        "shopware/core": "^6.6"
    },
    "autoload": {
        "psr-4": {
            "Tp24\\ShippingCountdown\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Tp24\\ShippingCountdown\\Tp24ShippingCountdown",
        "label": {
